#!/bin/bash
# Start (or restart) the skippy-xd daemon with the profile for this machine.
#
# Profiles live in ~/.config/skippy-xd/ (stowed from dotfiles/skippy-xd):
#   skippy-xd-work.rc   work setup, 2 monitors
#   skippy-xd-home.rc   home setup, single ultrawide
#
# Profile selection:
#   1. argument:   skippy-start work|home
#   2. override:   ~/.config/skippy-xd/profile containing "work" or "home" (untracked)
#   3. automatic:  2+ active monitors -> work, otherwise -> home
#   With --reload and no argument, the profile of the current skippy-xd.rc is kept.
#
# skippy-xd reads ~/.config/skippy-xd/skippy-xd.rc. That file is generated here
# (git-ignored): a copy of the selected profile, with [label] backgroundHighlight
# replaced by the per-machine pywal accent from ~/.config/skippy-xd/accent
# (written by skippy-accent). Its first line is a marker; a real file without the
# marker is backed up once to skippy-xd.rc.bak before being replaced.
# After editing a profile, run skippy-start (or skippy-start -r) to apply it.
#
# Options:
#   -n, --dry-run   only print the selected profile, change nothing
#   -r, --reload    regenerate skippy-xd.rc and reload the running daemon
#                   (no restart)

set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skippy-xd"
RC="$CONF_DIR/skippy-xd.rc"
OVERRIDE="$CONF_DIR/profile"
ACCENT_FILE="$CONF_DIR/accent"
MARKER="# GENERATED by skippy-start from"

DRY_RUN=0
RELOAD=0
PROFILE=""

for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=1 ;;
        -r|--reload)  RELOAD=1 ;;
        work|home)    PROFILE="$arg" ;;
        *) echo "usage: skippy-start [-n|--dry-run] [-r|--reload] [work|home]" >&2; exit 2 ;;
    esac
done

# Profile named in the marker line of the generated config, empty if none
CURRENT=""
if [ -f "$RC" ] && [ ! -L "$RC" ]; then
    CURRENT="$(sed -n "1s/^$MARKER skippy-xd-\([a-z]*\)\.rc.*/\1/p" "$RC")"
fi

if [ -n "$PROFILE" ]; then
    SOURCE="argument"
elif [ "$RELOAD" -eq 1 ] && [ -n "$CURRENT" ]; then
    PROFILE="$CURRENT"
    SOURCE="current $RC"
elif [ -f "$OVERRIDE" ]; then
    PROFILE="$(tr -d '[:space:]' < "$OVERRIDE")"
    SOURCE="override file $OVERRIDE"
else
    MONITORS="$(xrandr --listactivemonitors | sed -n 's/^Monitors: *//p')"
    if [ "${MONITORS:-1}" -ge 2 ]; then
        PROFILE="work"
    else
        PROFILE="home"
    fi
    SOURCE="${MONITORS:-?} active monitor(s)"
fi

TARGET="skippy-xd-$PROFILE.rc"
if [ ! -e "$CONF_DIR/$TARGET" ]; then
    echo "skippy-start: profile '$PROFILE' not found: $CONF_DIR/$TARGET" >&2
    exit 1
fi

echo "skippy-start: profile '$PROFILE' (from $SOURCE)"
if [ "$DRY_RUN" -eq 1 ]; then
    exit 0
fi

# A real config file not generated by this script is kept as a backup
if [ -e "$RC" ] && [ ! -L "$RC" ] && [ -z "$CURRENT" ]; then
    if [ -e "$RC.bak" ]; then
        echo "skippy-start: $RC is a real file and $RC.bak already exists, not overwriting" >&2
        exit 1
    fi
    mv "$RC" "$RC.bak"
    echo "skippy-start: backed up existing config to $RC.bak"
fi

ACCENT=""
if [ -f "$ACCENT_FILE" ]; then
    ACCENT="$(tr -d '[:space:]' < "$ACCENT_FILE")"
    if ! [[ "$ACCENT" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
        echo "skippy-start: invalid colour '$ACCENT' in $ACCENT_FILE, ignored" >&2
        ACCENT=""
    fi
fi

# Generate into a temp file, then replace the config (or the old symlink) at once
TMP="$(mktemp "$CONF_DIR/.skippy-xd.rc.XXXXXX")"
echo "$MARKER $TARGET - do not edit, edit the profile and run skippy-start" > "$TMP"
if [ -n "$ACCENT" ]; then
    sed '/^\[label\]/,/^\[/ s/^backgroundHighlight = .*/backgroundHighlight = '"$ACCENT"'/' \
        "$CONF_DIR/$TARGET" >> "$TMP"
else
    cat "$CONF_DIR/$TARGET" >> "$TMP"
fi
chmod 644 "$TMP"
mv -f "$TMP" "$RC"
echo "skippy-start: generated $RC (accent ${ACCENT:-from profile})"

# Match only the daemon: hotkey clients (--expose/--switch/--paging) are also
# called skippy-xd and hang forever when no daemon is listening.
DAEMON_PATTERN='^skippy-xd --start-daemon'

if [ "$RELOAD" -eq 1 ]; then
    if pgrep -f "$DAEMON_PATTERN" > /dev/null; then
        timeout 3 skippy-xd --config-reload > /dev/null 2>&1 || true
        echo "skippy-start: daemon reloaded"
    fi
    exit 0
fi

if pgrep -f "$DAEMON_PATTERN" > /dev/null; then
    timeout 3 skippy-xd --stop-daemon || true
    sleep 0.5
    pkill -f "$DAEMON_PATTERN" || true
fi
# Clients stuck without a daemon would otherwise stay around forever.
pkill -f '^skippy-xd --(expose|switch|paging)' || true

# Keep the daemon output, so a crash leaves a trace (exit code is logged too).
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/skippy-xd.log"
mkdir -p "$(dirname "$LOG")"
echo "=== $(date '+%F %T') skippy-start: profile '$PROFILE'" >> "$LOG"
# "|| DAEMON_RC=$?" keeps set -e from exiting before the exit code is logged
DAEMON_RC=0
skippy-xd --start-daemon >> "$LOG" 2>&1 || DAEMON_RC=$?
echo "=== $(date '+%F %T') skippy-xd daemon exited, rc=$DAEMON_RC" >> "$LOG"
exit $DAEMON_RC
