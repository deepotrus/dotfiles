#!/bin/bash
# Set the skippy-xd hover label colour ([label] backgroundHighlight) to the
# current pywal accent, then regenerate the active config and reload the daemon.
# Called by themesel after "wal" has generated the new palette.
#
# The colour is stored in ~/.config/skippy-xd/accent (per machine, git-ignored).
# The tracked profiles skippy-xd-{home,work}.rc are not touched: skippy-start
# applies the accent when it generates ~/.config/skippy-xd/skippy-xd.rc.
#
# Usage:
#   skippy-accent            use pywal color2 from ~/.cache/wal/colors
#   skippy-accent '#RRGGBB'  use an explicit colour

set -euo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/skippy-xd"
ACCENT_FILE="$CONF_DIR/accent"
WAL_COLORS="${XDG_CACHE_HOME:-$HOME/.cache}/wal/colors"

if [ $# -ge 1 ]; then
    ACCENT="$1"
else
    # ~/.cache/wal/colors has one colour per line, color0 first: color2 is line 3
    ACCENT="$(sed -n '3p' "$WAL_COLORS")"
fi

if ! [[ "$ACCENT" =~ ^#[0-9A-Fa-f]{6}$ ]]; then
    echo "skippy-accent: invalid colour '$ACCENT'" >&2
    exit 1
fi

mkdir -p "$CONF_DIR"
echo "$ACCENT" > "$ACCENT_FILE"
echo "skippy-accent: label highlight set to $ACCENT ($ACCENT_FILE)"

# Regenerate skippy-xd.rc with the new accent and reload the running daemon
# (called from this script's own folder, works without PATH set up)
"$(dirname "$(readlink -f "$0")")/skippy-start" --reload
