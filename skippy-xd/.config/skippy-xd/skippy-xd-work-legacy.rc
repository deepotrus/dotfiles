# LEGACY reference only: old 0.5-era work config, NOT read by skippy-xd 0.10.x.
# Its settings were converted into skippy-xd-work.rc.
[general]
distance = 50
useNetWMFullscreen = true
ignoreSkipTaskbar = true
updateFreq = 30.0
lazyTrans = true
pipePath = /tmp/skippy-xd-fifo
movePointerOnStart = true
movePointerOnSelect = true
movePointerOnRaise = true
switchDesktopOnActivate = true
useNameWindowPixmap = false
forceNameWindowPixmap = false
includeFrame = true
allowUpscale = true
showAllDesktops = false
showUnmapped = true
preferredIconSize = 32
clientDisplayModes = thumbnail icon filled none
iconFillSpec = orig mid mid #666666
fillSpec = orig mid mid #FFFFFF

[xinerama]
showAll = false


[label]
show = true
followsMouse = true
offsetX = 0
offsetY = 0
align = left
border = #111111
background = #333333
opacity = 256
text = #eedddd
textShadow = none
font = sans-10

[bindings]
miwMouse1 = focus
miwMouse2 = close-ewmh
miwMouse3 = iconify
